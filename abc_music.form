video,MP4:/literal{filmkes}/
    (
       label{xf_year} _ label{xf_monthstr}
    | label{xf_Year}
    | replace{"test"}
    | literal{""}
    )
    (
      / label{xf_make} " " label{xf_Model}
    | / label{xf_make}
    | / label{xf_model}
    | literal{""}
    )
    (
    / meaning{second}
    | literal{""}
    )
    /
(
  meaning{filename,0.5}
| meaning{top,0.54}
| meaning{best}
| subdir{-2}
| label{FileName}
| " video "
)
(
_label{xf_durationstr}
| literal{""}
)
name:literal{""};

text:/literal{"skrift"}/
(  label{xf_year} _ label{xf_mountstr} |
   label{xf_year} |
   literal{""}
)
name:label{FileName}
;

default:/literal{"undefined default"}/name:subdir{0};


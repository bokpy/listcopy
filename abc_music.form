audio:/literal{"audio"} /
     (
      label{mb_artist,95[:1]} / label{mb_artist,95} | # all artists that score the percentage of the artist on top
      label{xf_AlbumArtist[:1]}  / label{xf_AlbumArtist} |
      label{mb_performer[:1]}  / label{mb_performer} |
      label{xf_Composer[:1]} / label{xf_Composer}  |
      label{xf_Author[:1]}  / label{xf_Author} |
      label{mb_name,95[:1]}  / label{mb_name,95} |
      "@" /
     )
     (
     / label{xf_AlbumTitle} |
     / label{mb_album,97}  |
     / meaning{subdir,->,0.7} |
     / label{mb_cover,97}  |
     / label{xf_Publisher} |
      ""
     )
     /
     (
     "-" label{xf_TrackNumber:02} "- " |
     "-" label{mb_position:02} "- " |
     ""
     )
     (
     label{mb_title,97} |
     meaning{subdir,<-,0.7} |
     label{xf_title}   |
     meaning{filename,0.6} |
     literal{"Unidentified"} _label{xf_durationstr}
     # meaning{xf_top,0.6} |
     # meaning{second} _ meaning{first} |
     #meaning{first}   |
     #label{shortname} |
     literal{"Unidentified"}
     )
     name:literal{""}
     ;


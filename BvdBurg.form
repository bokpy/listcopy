# BvdBurg.form
# An example file to use as a parameter of the --substitute -s option of listcopy.

ISO:/literal{"fideo/kompaktdisk"}
    ( / label{VolumeName}|
     literal{""}
    )
    (
    / subdir{-2} literal{" jier "} label{year} |
    / subdir{-2} |
    / literal{"jier "} label{year}  |
    literal{""}
    )
    / name:subdir{-1}
    ;

JSON:/literal{"json"}/name:subdir{0};

image:/literal{ôfbyldings} ( / label{year} ( _label{monthstr} | literal{""} ) | literal{""} )
( label{Make} (  _ label{Model} |  literal{""} ) | literal{"gjin tastel"} )
/
(  meaning{top,5.0} |
   label{ExifImageWidth} literal{x}  label{ExifImageHeight} |
   literal{"fototsje"}
)



name:literal{""};


audio:/literal{lûd_en_ferskes}
     (
     / label{Genre} ( / label{artist} | / label{names} | literal{"ûnbekend"}) / label{album} |
     / literal{"ferskate"} ( / label{artist} | / label{names} | literal{"ûnbekend"} ) / label{album} |
     / label{artist} / label{album} |
     / literal{"ferskate"} / label{Artist} |
     / literal{"ferskate"} /  label{Album} |
     / label{year}_label{monthstr} |
     / label{year} |
        literal{""}
     )
     (
     / label{title} |
     / meaning{top,0.6} |
     / meaning{second} / meaning{first} |
     / meaning{first} |
     / label{shortname} |
     / literal{"moniker"}
     )
     /

     name:meaning{all}
     ;

video,MP4:/literal{filmkes}
    (
 #   / label{year} _ label{month} / label{addr:city} _ label{addr:street} _ label{addr:housenumber}
 # | / label{year} _ label{month} / label{addr:city} _ label{addr:street}
 # | / label{year} _ label{month} / label{addr:city} _ label{addr:street}
 # | / label{addr:city} _ label{addr:street}
 # | / label{year} _ label{month} _ label{day}
 # | / regex{"r'dit is een regular expression'"}
    / label{year} _ label{month}
    | / label{Year}
    | replace{"test"}
    | literal{""}
    )
    (
      / label{make} literal{" model "} label{Model}
    | / label{make}
    | / label{model}
    | literal{""}
    )
    (
    / meaning{second}
    | literal{""}
    )
( / meaning{top,0.54}
| / meaning{best}
| / subdir{-2}
| / label{FileName}
)
(
_label{durationstr}
| literal{""}
)
name:literal{""};

default:/literal{"undefined default"}/name:subdir{0};
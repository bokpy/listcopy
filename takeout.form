ISO:/literal{"fideo/kompaktdisk"}
    ( / label{VolumeName}|
     literal{""}
    )
    (
    / subdir{-2} literal{" jier "} label{year} |
    / subdir{-2} |
    / literal{"jier "} label{year}  |
    literal{""}
    )
    / name:subdir{-1}
    ;

# google takeout handling

JSON:/literal{"json"}/name:subdir{0};

image,PSD:/"ôfbyldings"/

    (
     label{year}_label{monthstr}  / label{addr:city}_label{addr:street}_label{addr:housenumber} |
     label{year}_label{monthstr}  / label{addr:city}_label{addr:street} |
     label{year} / label{addr:city}_label{addr:street} |
     label{addr:city}_label{addr:street} _label{addr:housenumber} |
     label{addr:city}_label{addr:street}  |
     label{year}_label{monthstr} |
     label{year} |
     literal{"no year no address"}
    )
    (
    / label{make} " model " label{Model}
    | / label{make}
    | / label{model}
    | literal{""}
    )
(
  / meaning{top,0.6}
| / meaning{second} / meaning{first}
| / meaning{first}
| / label{shortname}
| / literal{"moniker"}
)
name:literal{""};

###################################################################################################
#                                                                                                 #
# lûd en ferskes <--> lûd en ferskes <--> lûd en ferskes <--> lûd en ferskes <--> lûd en ferskes  #
#                                                                                                 #
###################################################################################################

audio:/literal{"lûd en ferskes"}
     (
     / label{Genre} |
     / label{Genres}  |
     / label{ProviderStyle} |
     / "No Style" |
     #/ label{year} |
     #/ "samar wat"
     )
     (
     / label{artists,95} | # all artists that score the percentage of the artist on top
     / label{AlbumArtist} |
     / label{Composer}  |
     / label{Author} |
     / label{names,95} |
     / "undetectedlieteral"
     )
     (
     / label{albums,97}  |
     / label{covers,97}  |
     / label{AlbumTitle} |
      ""
     )
     /
     (
     "-" label{TrackNumber:02} "- " |
     ""
     )
     (
     label{Titles,97} |
     label{title,1}   |
     meaning{filename,0.6} |
     meaning{top,0.6} |
     meaning{second} _ meaning{first} |
     meaning{first}   |
     label{shortname} |
     literal{"moniker"}
     )
     name:literal{""}
     ;


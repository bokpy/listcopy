 # | / label{year} _ label{monthstr} _ label{day}
 # | / regex{"r'dit is een regular expression'"}
    / label{year} _ label{monthstr}
    | / label{Year}
    | replace{"test"}
    | literal{""}
    )
    (
      / label{make} " " label{Model}
    | / label{make}
    | / label{model}
    | literal{""}
    )
    (
    / meaning{second}
    | literal{""}
    )
(
  / meaning{filename,0.5}
| / meaning{top,0.54}
| / meaning{best}
| / subdir{-2}
| / label{FileName}
)
(
_label{durationstr}
| literal{""}
)
name:literal{""};

text:/literal{"skrift"}/

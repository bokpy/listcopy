ISO:/literal{"fideo/kompaktdisk"}
    ( / label{VolumeName}|
     literal{""}
    )
    (
    / subdir{-2} literal{" jier "} label{year} |
    / subdir{-2} |
    / literal{"jier "} label{year}  |
    literal{""}
    )
    / name:subdir{-1}
    ;

# google takeout handling

JSON:/literal{"json"}/name:subdir{0};

image,PSD:/"ôfbyldings"/

    (
     label{xf_year}_label{xf_monthstr}  / label{addr:city}_label{addr:street}_label{addr:housenumber} |
     label{xf_year}_label{xf_monthstr}  / label{addr:city}_label{addr:street} |
     label{xf_year} / label{addr:city}_label{addr:street} |
     label{addr:city}_label{addr:street} _label{addr:housenumber} |
     label{addr:city}_label{addr:street}  |
     label{xf_year}_label{xf_monthstr} |
     label{xf_year} |
     literal{"no year no address"}
    )
    (
    / label{xf_make} " model " label{xf_Model}
    | / label{xf_make}
    | / label{xf_model}
    | literal{""}
    )
(
  / meaning{top,0.6}
| / meaning{second} / meaning{first}
| / meaning{first}
| / label{shortname}
| / literal{"moniker"}
)
name:literal{""};

###################################################################################################
#                                                                                                 #
# lûd en ferskes <--> lûd en ferskes <--> lûd en ferskes <--> lûd en ferskes <--> lûd en ferskes  #
#                                                                                                 #
###################################################################################################

audio:/literal{"lûd en ferskes"}
     (
     / label{xf_Genre} |
     / label{mb_genre}  |
     / label{xf_ProviderStyle} |
     / "No Style" |
     #/ label{xf_year} |
     #/ "samar wat"
     )
     (
     / label{mb_artist,95} | # all artists that score the percentage of the artist on top
     / label{xf_AlbumArtist} |
     / label{mb_performer} |
     / label{xf_Composer}  |
     / label{xf_Author} |
     / label{mb_name,95} |
     / "undetected"
     )
     (
     / label{xf_AlbumTitle} |
     / label{mb_album,97}  |
     / label{mb_cover,97}  |
     / label{xf_Publisher} |
      ""
     )
     /
     (
     "-" label{xf_TrackNumber:02} "- " |
     "-" label{mb_position:02} "- " |
     ""
     )
     (
     label{mb_title,97} |
     label{xf_title}   |
     meaning{filename,0.6} |
     meaning{xf_top,0.6} |
     meaning{second} _ meaning{first} |
     meaning{first}   |
     label{shortname} |
     literal{"moniker"}
     )
     name:literal{""}
     ;


video,MP4:/literal{filmkes}
    (
 #   / label{year} _ label{monthstr} / label{addr:city} _ label{addr:street} _ label{addr:housenumber}
 # | / label{year} _ label{monthstr} / label{addr:city} _ label{addr:street}
